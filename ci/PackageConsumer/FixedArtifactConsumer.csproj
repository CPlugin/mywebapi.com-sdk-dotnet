<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SdkVersion Condition="'$(SdkVersion)' == ''">0.3.0</SdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MyWebApi.Sdk" Version="$(SdkVersion)" />
    <PackageReference Include="MyWebApi.Sdk.Models" Version="$(SdkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
