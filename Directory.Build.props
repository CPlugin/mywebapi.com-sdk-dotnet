<Project>
  <PropertyGroup>
    <Version>0.4.0</Version>
    <Authors>CPlugin</Authors>
    <Company>CPlugin</Company>
    <!-- * Project URL is the product site; the source repository is RepositoryUrl (shown on nuget.org as "Source repository"). -->
    <PackageProjectUrl>https://mywebapi.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CPlugin/mywebapi.com-sdk-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- * Platform names only as nominative compatibility wording (owner decision 03.10.2026); package IDs stay neutral. -->
    <PackageReleaseNotes>0.4.0: v2 surface parity — 45 new MT5 operations (clients, deals, orders, positions, history, users, symbols, dealer balance) and the returned MT4 configuration operations (CfgRequestCommon, CfgRequestGroup, CfgRequestSymbolGroup, CfgUpdateGroup, UsersGet), MT5 names aligned with the platform (TimeServer, OrderGetByGroup, DealRequestByGroup, PositionRequestByGroup), update bodies send only the fields that are set, per-platform SignalR connection-status handlers (OnMT4ConnectionStatus / OnMT5ConnectionStatus); specification refreshed — 224 operations. Breaking changes are listed in the changelog. Full notes: https://github.com/CPlugin/mywebapi.com-sdk-dotnet/blob/v0.4.0/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>mt4;mt5;metatrader;metatrader4;metatrader5;mt4-api;mt5-api;broker;forex;trading;trading-platform;rest-api;websocket;signalr;real-time;sdk;openapi;cplugin;mywebapi;webapi</PackageTags>
    <!-- * SourceLink (built into the .NET 8+ SDK) + debug symbols for nuget.org. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- * One repo-level README ships inside both packages (harmless for the
         non-packable test/example/tool projects). -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
