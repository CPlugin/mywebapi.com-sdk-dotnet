<Project>
  <PropertyGroup>
    <Version>0.5.1</Version>
    <Authors>CPlugin</Authors>
    <Company>CPlugin</Company>
    <!-- * Project URL is the product site; the source repository is RepositoryUrl (shown on nuget.org as "Source repository"). -->
    <PackageProjectUrl>https://mywebapi.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CPlugin/mywebapi.com-sdk-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- * Platform names only as nominative compatibility wording (owner decision 03.10.2026); package IDs stay neutral. -->
    <PackageReleaseNotes>0.5.1: the models are refreshed from the v2 document of the stand. Subscription fields are now named enumerations — status, action, type, controlMode, periodMode, periodFreeMode, level and tickHistory — and the subscription flags travel as their names in one string ("Enable, AutoProlong", "None", "Bit&lt;n&gt;"). The tick statistics carry the option greeks (priceGreeksDelta, Theta, Gamma, Vega, Rho, Omega) and priceSensitivity, and the news time is documented as the wall-clock time of the trade server. The operation surface is unchanged: 456 operations. Full notes: https://github.com/CPlugin/mywebapi.com-sdk-dotnet/blob/v0.5.1/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>mt4;mt5;metatrader;metatrader4;metatrader5;mt4-api;mt5-api;broker;forex;trading;trading-platform;rest-api;websocket;signalr;real-time;sdk;openapi;cplugin;mywebapi;webapi</PackageTags>
    <!-- * SourceLink (built into the .NET 8+ SDK) + debug symbols for nuget.org. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- * One repo-level README ships inside both packages (harmless for the
         non-packable test/example/tool projects). -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
