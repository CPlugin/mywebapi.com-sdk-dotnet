<Project>
  <PropertyGroup>
    <Version>0.3.4</Version>
    <Authors>CPlugin</Authors>
    <Company>CPlugin</Company>
    <!-- * Project URL is the product site; the source repository is RepositoryUrl (shown on nuget.org as "Source repository"). -->
    <PackageProjectUrl>https://mywebapi.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CPlugin/mywebapi.com-sdk-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- * Platform names only as nominative compatibility wording (owner decision 03.10.2026); package IDs stay neutral. -->
    <PackageReleaseNotes>0.3.4: MT5 chart and tick history over REST (ChartRequestAsync, TicksHistoryAsync); live MT5 ticks on the v2 hub (OnTick, StreamTicks, SubscribeToTicks, UnsubscribeFromTicks); batched ticks on the MT4 and MT5 v2 hubs (OnTicksBatch, SubscribeToTicksBatch, UnsubscribeFromTicksBatch); specification refreshed — 174 operations. Full notes: https://github.com/CPlugin/mywebapi.com-sdk-dotnet/blob/v0.3.4/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>mt4;mt5;metatrader;metatrader4;metatrader5;mt4-api;mt5-api;broker;forex;trading;trading-platform;rest-api;websocket;signalr;real-time;sdk;openapi;cplugin;mywebapi;webapi</PackageTags>
    <!-- * SourceLink (built into the .NET 8+ SDK) + debug symbols for nuget.org. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- * One repo-level README ships inside both packages (harmless for the
         non-packable test/example/tool projects). -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
