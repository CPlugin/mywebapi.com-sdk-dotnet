<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <!-- * Public NuGet id (brand parity with @mywebapi.com/sdk and mywebapi-sdk).
         Root namespace stays CPlugin.SaaSWebApi.Models — same split as the Python
         SDK (dist mywebapi-sdk / import cplugin_webapi_sdk). -->
    <PackageId>MyWebApi.Sdk.Models</PackageId>
    <Description>POCO DTOs and response envelopes for CPlugin WebAPI, the REST API that works with MetaTrader 4 and MetaTrader 5 servers. Zero dependencies beyond System.Text.Json; use it when you build your own HTTP layer. MetaTrader is a trademark of MetaQuotes Ltd.; this package is not affiliated with MetaQuotes.</Description>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
